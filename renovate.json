{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "ignorePresets": [":ignoreModulesAndTests"],
  "ignorePaths": ["**/node_modules/**", "packaging/templates/**"],
  "automerge": false,
  "packageRules": [
    {
      "description": "New Node.js majors require updating CI, the supported minimum, and the bridge runtime together.",
      "matchPackageNames": ["node", "actions/node-versions", "nodejs-current"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Upgrade the bridge's Alpine release together with the Node.js package it ships.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["bridge/Dockerfile"],
      "matchPackageNames": ["alpine"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
