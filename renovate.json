{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "ignorePresets": [":ignoreModulesAndTests"],
  "ignorePaths": ["**/node_modules/**", "packaging/templates/**"],
  "automerge": false,
  "packageRules": [
    {
      "description": "Review Node.js major upgrades manually for compatibility with older DSM kernels.",
      "matchPackageNames": ["node", "actions/node-versions"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the bridge on the Alpine release that supplies its Node 22 runtime.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["bridge/Dockerfile"],
      "matchPackageNames": ["alpine"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Leave the APK Node major constraint in place; Alpine supplies patches within it.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["bridge/Dockerfile"],
      "matchDepNames": ["nodejs"],
      "enabled": false
    }
  ]
}
