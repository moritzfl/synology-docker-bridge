{
  "$schema": "../../packaging/app.schema.json",
  "id": "dsm-nginx-demo",
  "version": "0.1.0",
  "displayName": "DSM Nginx Demo",
  "description": "Generic Docker web UI embedded in a DSM desktop window",
  "descriptionGer": "Docker-Weboberfläche in einem DSM-Desktopfenster",
  "maintainer": "Moritz",
  "image": "dsm-nginx-demo:spk",
  "appBuild": "docker buildx build --platform linux/amd64 --provenance=false --sbom=false --load -t dsm-nginx-demo:spk .",
  "containerPort": 80,
  "icon": "icon.svg",
  "output": false,
  "identityHeaders": true,
  "ui": {
    "width": 1000,
    "height": 700
  }
}
