#!/bin/sh
# Shared runtime configuration for install/upgrade. Sourced, not executed.

PKG="{{id}}"
DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
ENV_FILE="$DEST/docker/.env"
STATE_ENV="$VAR/app.env"
TOKEN_FILE="$VAR/token"
CONTROL_FILE="$VAR/bridge-port"
INTERNAL_FILE="$VAR/internal-port"
NGINX_CONF="/etc/nginx/nginx.conf"
umask 077

valid_port() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}


ensure_token() {
    mkdir -p "$VAR"
    if [ ! -s "$TOKEN_FILE" ]; then
        dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' >"$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    fi
}

# The app's host port is random rather than derived from the package id: another local process
# must not be able to predict and occupy the loopback port before the app starts, which is where
# the bridge sends the identity headers and X-Bridge-Secret.
choose_port() {
    file="$1"
    fixed="$2"
    base="$3"
    saved="$(cat "$file" 2>/dev/null || true)"
    avoid="${4:-}"
    if [ -n "$fixed" ]; then
        port="$fixed"
    elif valid_port "$saved" && [ "$saved" != "$avoid" ]; then
        port="$saved"
    else
        attempts=0
        while [ "$attempts" -lt 32 ]; do
            number="$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')"
            case "$number" in ''|*[!0-9]*) return 1 ;; esac
            port=$((base + number % 10000))
            hex="$(printf '%04X' "$port")"
            if [ "$port" != "$avoid" ] && ! awk -v port=":$hex" '$4 == "0A" && $2 ~ port "$" { found=1 } END { exit !found }' \
                /proc/net/tcp /proc/net/tcp6 2>/dev/null; then break; fi
            attempts=$((attempts + 1))
        done
        [ "$attempts" -lt 32 ] || return 1
    fi
    printf '%s\n' "$port"
}

configure_ports() {
    # Container Manager can still reserve the previous Docker port after stopping the project.
    # A replacement project needs a different private mapping even if nothing is listening.
    previous=""
    if [ "{{hostNetwork}}" != true ]; then
        previous="$(cat "$INTERNAL_FILE" 2>/dev/null || true)"
        valid_port "$previous" || previous="$(sed -n 's/^APP_INTERNAL_PORT=//p' "$STATE_ENV" 2>/dev/null | head -1)"
    fi
    internal="$(choose_port "$INTERNAL_FILE" "{{fixedInternalPort}}" 20000 "$previous")"
    control="$(choose_port "$CONTROL_FILE" "{{fixedControlPort}}" 30000)"
    set_env APP_INTERNAL_PORT "$internal"
    if [ "{{hostNetwork}}" = true ]; then set_env APP_CONTAINER_PORT "$internal"; fi
    set_env BRIDGE_CONTROL_PORT "$control"
    for conf in "$(dirname "$ENV_FILE")"/../config/*.bridge.conf; do
        [ -f "$conf" ] || continue
        tmp="$(mktemp "$conf.XXXXXX")"
        sed "s@proxy_pass http://127\\.0\\.0\\.1:{{controlPort}}/@proxy_pass http://127.0.0.1:$control/@g" "$conf" >"$tmp" &&
            chmod 644 "$tmp" && mv "$tmp" "$conf"
    done
}

record_ports() {
    mkdir -p "$VAR"
    get_env APP_INTERNAL_PORT >"$INTERNAL_FILE"
    get_env BRIDGE_CONTROL_PORT >"$CONTROL_FILE"
}

set_env() {
    key="$1"
    value="$2"
    if grep -q "^$key=" "$ENV_FILE" 2>/dev/null; then
        tmp="$(mktemp "$ENV_FILE.XXXXXX")"
        awk -v key="$key" -v value="$value" '
            BEGIN { FS = "=" }
            $1 == key { print key "=" value; next }
            { print }
        ' "$ENV_FILE" >"$tmp" && mv "$tmp" "$ENV_FILE"
    else
        printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
    fi
}

unset_env() {
    [ -f "$ENV_FILE" ] || return 0
    tmp="$(mktemp "$ENV_FILE.XXXXXX")"
    grep -v "^$1=" "$ENV_FILE" >"$tmp" || true
    mv "$tmp" "$ENV_FILE"
}

# DSM's time zone by name, e.g. Europe/Berlin: /etc/localtime links into zoneinfo.
host_timezone() {
    zone="$(readlink /etc/localtime 2>/dev/null | sed -n 's#^.*/zoneinfo/##p')"
    case "$zone" in
        ''|*[!A-Za-z0-9/_+-]*) zone="Etc/UTC" ;;
    esac
    printf '%s\n' "$zone"
}

# Where devices on the network reach the app's public paths: the NAS's LAN address on DSM's own
# HTTP port. Empty when the package has none, or when either cannot be found.
public_url() {
    prefix="{{publicPrefix}}"
    own_port="{{publicPort}}"
    [ -n "$prefix" ] || [ -n "$own_port" ] || return 0
    address="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)"
    if [ -z "$address" ]; then
        address="$(ip -4 -o addr show scope global 2>/dev/null | grep -v docker | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -1)"
    fi
    port="$(sed -n 's/^[[:space:]]*listen \([0-9]*\) default_server;$/\1/p' "$NGINX_CONF" 2>/dev/null | head -1)"
    case "$address" in
        ''|*[!0-9.]*) return 0 ;;
    esac
    valid_port "$port" || port=5000
    # Apps on ports of their own serve their public paths there, at the root.
    [ -n "$own_port" ] && port="$own_port"
    printf 'http://%s:%s%s\n' "$address" "$port" "$prefix"
}

# DSM's own HTTP or HTTPS port, e.g. 5000 or 5001, for links from the app's own address back to DSM.
dsm_port() {
    case "$1" in
        https) pattern='s/^[[:space:]]*listen \([0-9]*\) default_server ssl;$/\1/p'; port=5001 ;;
        *) pattern='s/^[[:space:]]*listen \([0-9]*\) default_server;$/\1/p'; port=5000 ;;
    esac
    found="$(sed -n "$pattern" "$NGINX_CONF" 2>/dev/null | head -1)"
    valid_port "$found" && port="$found"
    printf '%s\n' "$port"
}

get_env() {
    sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | head -1
}

ensure_env() {
    mkdir -p "$DEST/docker" "$VAR"
    if [ -f "$STATE_ENV" ]; then
        copy_private "$STATE_ENV" "$ENV_FILE"
    fi
    if [ ! -f "$ENV_FILE" ]; then
        : >"$ENV_FILE"
    fi

    saved_output="$(get_env APP_OUTPUT_DIR)"
    saved_internal="$(get_env APP_INTERNAL_PORT)"
    generated_internal="$(cat "$INTERNAL_FILE" 2>/dev/null || true)"
    valid_port "$generated_internal" || generated_internal="$saved_internal"
    saved_container_port="$(get_env APP_CONTAINER_PORT)"

    # Earlier versions could open a direct bridge port; the app is now on DSM's ports only.
    unset_env APP_PORT
    set_env APP_IMAGE "{{image}}"
    set_env BRIDGE_IMAGE "{{bridgeImage}}"
    set_env APP_CONTAINER "{{container}}"
    set_env APP_DATA_DIR "{{dataDirDefault}}"
    set_env APP_TZ "$(host_timezone)"
    set_env APP_PUBLIC_URL "$(public_url)"
    set_env DSM_HTTP_PORT "$(dsm_port http)"
    set_env DSM_HTTPS_PORT "$(dsm_port https)"
    set_env APP_INTERNAL_PORT "${generated_internal:-{{hostPort}}}"
    if [ "{{hostNetwork}}" = true ]; then saved_container_port="$generated_internal"; fi
    set_env APP_CONTAINER_PORT "${saved_container_port:-{{containerPort}}}"
    set_env BRIDGE_CONTROL_PORT "$(cat "$CONTROL_FILE")"
    # The bridge finds the share's real volume when it starts; these are only the defaults.
    set_env APP_OUTPUT_PARENT "{{outputParent}}"
    set_env APP_OUTPUT_DIR "${saved_output:-{{defaultOutputDir}}}"
    set_env APP_OUTPUT_CONTAINER_DIR "{{outputContainerRoot}}/{{outputLink}}"
}

save_env() {
    copy_private "$ENV_FILE" "$STATE_ENV"
}

copy_private() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    tmp="$(mktemp "$2.XXXXXX")"
    cat "$1" >"$tmp" && mv -f "$tmp" "$2"
}
